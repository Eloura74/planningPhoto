# Server
PORT=5000

# Database (SQLite - pas de configuration nécessaire)
# La base de données sera créée automatiquement dans planning.db

# JWT
JWT_SECRET=your-secret-key-change-this-in-production

# Email Brevo (Requis pour les notifications)
BREVO_API_KEY=votre-api-key-brevo
BREVO_FROM_EMAIL=noreply@planningphoto.com

# WhatsApp CallMeBot (Optionnel - notifications admin)
# 1. Ajouter le contact: +34 644 44 71 67
# 2. Envoyer: "I allow callmebot to send me messages"
# 3. Copier l'API Key reçue ci-dessous
CALLMEBOT_API_KEY=
